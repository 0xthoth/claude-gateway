{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://claude-gateway.dev/contracts/files-git/files-mkdir-request.schema.json",
  "title": "FilesMkdirRequest",
  "description": "JSON body of POST /v1/files/mkdir. Only git_init === true runs git init.",
  "type": "object",
  "properties": {
    "path": {
      "type": "string",
      "pattern": "^$|^[A-Za-z0-9][A-Za-z0-9._-]{0,63}(/[A-Za-z0-9][A-Za-z0-9._-]{0,63}){0,31}$",
      "minLength": 1
    },
    "git_init": {
      "type": "boolean"
    }
  },
  "required": [
    "path"
  ],
  "additionalProperties": false
}
