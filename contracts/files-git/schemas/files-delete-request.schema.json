{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://claude-gateway.dev/contracts/files-git/files-delete-request.schema.json",
  "title": "FilesDeleteRequest",
  "description": "JSON body of DELETE /v1/files. confirm is the last segment of path.",
  "type": "object",
  "properties": {
    "path": {
      "type": "string",
      "pattern": "^$|^[A-Za-z0-9][A-Za-z0-9._-]{0,63}(/[A-Za-z0-9][A-Za-z0-9._-]{0,63}){0,31}$",
      "minLength": 1
    },
    "confirm": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    }
  },
  "required": [
    "path",
    "confirm"
  ],
  "additionalProperties": false
}
