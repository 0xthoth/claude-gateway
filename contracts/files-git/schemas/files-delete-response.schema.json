{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://claude-gateway.dev/contracts/files-git/files-delete-response.schema.json",
  "title": "FilesDeleteResponse",
  "description": "200 body of DELETE /v1/files.",
  "type": "object",
  "properties": {
    "path": {
      "type": "string",
      "pattern": "^$|^[A-Za-z0-9][A-Za-z0-9._-]{0,63}(/[A-Za-z0-9][A-Za-z0-9._-]{0,63}){0,31}$",
      "minLength": 1
    },
    "warning": {
      "type": "string"
    }
  },
  "required": [
    "path"
  ],
  "additionalProperties": false
}
