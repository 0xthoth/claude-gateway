{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://claude-gateway.dev/contracts/files-git/session-create-response.schema.json",
  "title": "SessionCreateResponse",
  "description": "201 body of POST /v1/agents/:agentId/sessions.",
  "type": "object",
  "required": [
    "sessionId",
    "sessionName",
    "createdAt",
    "cwd",
    "trusted",
    "cwdState",
    "active"
  ],
  "additionalProperties": false,
  "properties": {
    "sessionId": {
      "type": "string"
    },
    "sessionName": {
      "type": "string"
    },
    "createdAt": {
      "type": "integer"
    },
    "cwd": {
      "type": [
        "string",
        "null"
      ]
    },
    "trusted": {
      "type": "boolean"
    },
    "cwdState": {
      "enum": [
        "available",
        "missing",
        "unavailable",
        null
      ]
    },
    "active": {
      "type": "boolean"
    }
  }
}
