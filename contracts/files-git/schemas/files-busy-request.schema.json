{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://claude-gateway.dev/contracts/files-git/files-busy-request.schema.json",
  "title": "FilesBusyRequest",
  "description": "JSON body of POST /v1/files/busy (admin key).",
  "type": "object",
  "properties": {
    "paths": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}(/[A-Za-z0-9][A-Za-z0-9._-]{0,63}){0,31}$"
      }
    }
  },
  "required": [
    "paths"
  ],
  "additionalProperties": false
}
