{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://claude-gateway.dev/contracts/files-git/files-busy-response.schema.json",
  "title": "FilesBusyResponse",
  "description": "200 body of POST /v1/files/busy. Advisory: session is reported but does not make busy true. A path that did not resolve has abs null and error set.",
  "type": "object",
  "required": [
    "results"
  ],
  "additionalProperties": false,
  "properties": {
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "abs",
          "busy",
          "reasons"
        ],
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}(/[A-Za-z0-9][A-Za-z0-9._-]{0,63}){0,31}$"
          },
          "abs": {
            "type": [
              "string",
              "null"
            ]
          },
          "busy": {
            "type": "boolean"
          },
          "reasons": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "enum": [
                "turn",
                "spawn",
                "task",
                "session",
                "marked",
                "deleting"
              ]
            }
          },
          "error": {
            "type": "string"
          }
        }
      }
    }
  }
}
