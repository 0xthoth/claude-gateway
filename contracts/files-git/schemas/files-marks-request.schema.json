{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://claude-gateway.dev/contracts/files-git/files-marks-request.schema.json",
  "title": "FilesMarksRequest",
  "description": "JSON body of POST /v1/files/marks (admin key).",
  "type": "object",
  "properties": {
    "path": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}(/[A-Za-z0-9][A-Za-z0-9._-]{0,63}){0,31}$"
    },
    "purpose": {
      "enum": [
        "cleaning",
        "starting"
      ]
    },
    "ttlSec": {
      "type": "integer",
      "minimum": 60,
      "maximum": 300
    }
  },
  "required": [
    "path",
    "purpose",
    "ttlSec"
  ],
  "additionalProperties": false
}
