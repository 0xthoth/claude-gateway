{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://claude-gateway.dev/contracts/files-git/git-summary.schema.json",
  "title": "GitSummary",
  "description": "200 body of GET /v1/git/summary: one entry per repository directly under path, null when its read failed.",
  "type": "object",
  "properties": {
    "summaries": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
      },
      "additionalProperties": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "branch": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "detached": {
                "type": "boolean"
              },
              "sync": {
                "enum": [
                  "in_sync",
                  "ahead",
                  "behind",
                  "diverged",
                  "no_upstream",
                  "upstream_gone",
                  "upstream_mismatch",
                  "no_remote",
                  "detached"
                ]
              },
              "ahead": {
                "type": "integer",
                "minimum": 0
              },
              "behind": {
                "type": "integer",
                "minimum": 0
              },
              "change_count": {
                "type": "integer",
                "minimum": 0
              },
              "conflicted_count": {
                "type": "integer",
                "minimum": 0
              },
              "remote_host": {
                "anyOf": [
                  {
                    "enum": [
                      "github",
                      "gitlab",
                      "bitbucket",
                      "other"
                    ]
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "branch",
              "detached",
              "sync",
              "ahead",
              "behind",
              "change_count",
              "conflicted_count",
              "remote_host"
            ],
            "additionalProperties": false
          },
          {
            "type": "null"
          }
        ]
      }
    }
  },
  "required": [
    "summaries"
  ],
  "additionalProperties": false
}
