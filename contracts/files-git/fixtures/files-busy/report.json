      "paths": [
        "busy",
        "app",
        "nope"
      ]
    }
  },
  "status": 200,
  "schema": "FilesBusyResponse",
  "body": {
    "results": [
      {
        "path": "busy",
        "abs": "/home/user/projects/busy",
        "busy": true,
        "reasons": [
          "turn"
        ]
      },
      {
        "path": "app",
        "abs": "/home/user/projects/app",
        "busy": false,
        "reasons": []
      },
      {
        "path": "nope",
        "abs": null,
        "busy": false,
        "reasons": [],
        "error": "not_found"
      }
    ]
  }
}
